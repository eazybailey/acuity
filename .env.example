# Copy to .env.local for local dev. Real values live only in Vercel env vars, never in git.

# --- Sign-in (lib/session.ts). Refused in both modes when VERCEL_ENV=production.
# Long random string used to HMAC-sign session and studio cookies. Login is refused if unset.
SESSION_SECRET=

# Magic link (Supabase Auth). Used instead of the access code when all three are set.
# Supabase > Project Settings > API: project URL and the anon / publishable key.
# NEVER put a service-role / secret key here or anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute origin of this deployment (e.g. the preview URL). Emailed links go to
# <APP_URL>/auth/confirm; must also be in Supabase's Redirect URLs allow-list.
APP_URL=

# Preview access-code stand-in: shared code testers type on /login. Only used when the
# magic link is not configured.
SKELETON_ACCESS_CODE=

# --- Acuity, one account per studio: Acuity > Integrations > API > User ID / API Key.
# A studio without both vars is "not connected" and hidden from clients.
# Only MH (Muswell Hill Road) is ever written to; the rest are read-only in code.
ACUITY_USER_ID_AP=
ACUITY_API_KEY_AP=
ACUITY_USER_ID_CH=
ACUITY_API_KEY_CH=
ACUITY_USER_ID_HB=
ACUITY_API_KEY_HB=
ACUITY_USER_ID_HGS=
ACUITY_API_KEY_HGS=
ACUITY_USER_ID_LL=
ACUITY_API_KEY_LL=
ACUITY_USER_ID_MH=
ACUITY_API_KEY_MH=
ACUITY_USER_ID_PR=
ACUITY_API_KEY_PR=
ACUITY_USER_ID_SG=
ACUITY_API_KEY_SG=
ACUITY_USER_ID_WMH=
ACUITY_API_KEY_WMH=

# Muswell Hill Road (Gate 0) keys. Used by /gate0, and by MH when the _MH vars are unset.
ACUITY_USER_ID=
ACUITY_API_KEY=

# --- Gate 0 page (/gate0): shared secret for its API route.
GATE0_SECRET=

# Set by Vercel automatically (production / preview / development). Do not set by hand.
# VERCEL_ENV=
